3. Replace the existing simulation JavaScript (the runSimulation and resetSimulation functions, plus the slider listeners if you want to extend them) with this:

```javascript
// ---------- SIMULATION ----------
const rainfallInput = document.getElementById('rainfall');
const invasiveInput = document.getElementById('invasive-pressure');
const effortInput = document.getElementById('restoration-effort');
const timeInput = document.getElementById('time-scale');

const rainfallVal = document.getElementById('rainfall-value');
const invasiveVal = document.getElementById('invasive-value');
const effortVal = document.getElementById('effort-value');
const timeVal = document.getElementById('time-value');

rainfallInput.addEventListener('input', () => rainfallVal.textContent = rainfallInput.value + ' mm');
invasiveInput.addEventListener('input', () => invasiveVal.textContent = invasiveInput.value + '%');
effortInput.addEventListener('input', () => effortVal.textContent = effortInput.value + '%');
timeInput.addEventListener('input', () => timeVal.textContent = timeInput.value + ' years');

const COLS = 20;
const ROWS = 12;
const TOTAL_PLOTS = COLS * ROWS;

// Deterministic pseudo-random generator so each run is reproducible
function makeRng(seed) {
  let s = seed >>> 0;
  return function () {
    s = (s * 1664525 + 1013904223) >>> 0;
    return s / 4294967296;
  };
}

// Tiny SVG glyphs for native (grass tuft / shrub) and invasive (gorse spike)
const GLYPH_NATIVE = `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
  <path d="M12 22V12" stroke="#1e4a1e" stroke-width="2" stroke-linecap="round"/>
  <path d="M12 14c-3-1-5-4-5-7 3 0 5 2 5 5" fill="#4a9b3f"/>
  <path d="M12 14c3-1 5-4 5-7-3 0-5 2-5 5" fill="#3e7e3e"/>
  <path d="M12 18c-2.5-.5-4-2.5-4.5-5 2.5.3 4 2 4.5 4" fill="#5aad4f"/>
</svg>`;

const GLYPH_INVASIVE = `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
  <path d="M12 22V8" stroke="#5a1e1e" stroke-width="2" stroke-linecap="round"/>
  <path d="M9 10l3-4 3 4-1.5 2h-3z" fill="#c0392b"/>
  <path d="M9 15l3-3 3 3-1.5 1.8h-3z" fill="#a93226"/>
  <path d="M9 19l3-3 3 3-1.5 1.5h-3z" fill="#8a2a2a"/>
</svg>`;

// Soil-health colour interpolation (degraded → healthy)
function soilColor(health, moisture) {
  // health 0..1 ; moisture 0..1 (affects saturation/warmth)
  const stops = [
    { t: 0.0, c: [138, 122, 92] },   // cracked tan
    { t: 0.35, c: [201, 185, 138] }, // dry olive
    { t: 0.65, c: [122, 163, 79] },  // healthy grassland
    { t: 1.0, c: [43, 107, 43] }     // deep forest
  ];
  let lo = stops[0], hi = stops[stops.length - 1];
  for (let i = 0; i < stops.length - 1; i++) {
    if (health >= stops[i].t && health <= stops[i + 1].t) {
      lo = stops[i]; hi = stops[i + 1]; break;
    }
  }
  const span = (hi.t - lo.t) || 1;
  const f = (health - lo.t) / span;
  const r = Math.round(lo.c[0] + (hi.c[0] - lo.c[0]) * f);
  const g = Math.round(lo.c[1] + (hi.c[1] - lo.c[1]) * f);
  const b = Math.round(lo.c[2] + (hi.c[2] - lo.c[2]) * f);
  // Dry years wash out saturation
  const dryFade = 0.35 + moisture * 0.65;
  const r2 = Math.round(r * dryFade + 120 * (1 - dryFade));
  const g2 = Math.round(g * dryFade + 110 * (1 - dryFade));
  const b2 = Math.round(b * dryFade + 90 * (1 - dryFade));
  return `rgb(${r2},${g2},${b2})`;
}

function runSimulation() {
  const rainfall = parseInt(rainfallInput.value);       // 400..1200
  const invasive = parseInt(invasiveInput.value) / 100; // 0..1
  const effort = parseInt(effortInput.value) / 100;     // 0..1
  const time = parseInt(timeInput.value);               // 1..20

  // Seed per run so it feels alive but reproducible per click
  const seed = (rainfall * 7 + invasive * 131 + effort * 977 + time * 17 + Date.now() % 1000) | 0;
  const rand = makeRng(seed);

  // Global recovery: rainfall + effort help, invasives hurt, time compounds
  const moisture = Math.min(1, Math.max(0, (rainfall - 400) / 800));
  const baseRecovery = (effort * 0.55 + moisture * 0.35) - invasive * 0.45;
  const recovery = Math.min(1, Math.max(0, baseRecovery * Math.min(1.4, time / 6) + 0.15));

  // Build plots
  const plots = [];
  let nativeTotal = 0, invasiveTotal = 0, healthSum = 0;

  // Cluster centres for invasives (they group together)
  const invClusters = Array.from({ length: 4 + Math.round(invasive * 6) }, () => ({
    x: Math.floor(rand() * COLS),
    y: Math.floor(rand() * ROWS),
    r: 2 + rand() * 3
  }));

  for (let y = 0; y < ROWS; y++) {
    for (let x = 0; x < COLS; x++) {
      // Local invasive pressure: close to a cluster centre = higher
      let invLocal = 0;
      for (const c of invClusters) {
        const d = Math.hypot(x - c.x, y - c.y);
        invLocal += Math.max(0, 1 - d / c.r) * invasive;
      }
      invLocal = Math.min(1, invLocal);

      // Local native establishment: effort & moisture, reduced by invasives
      const natLocal = Math.min(1, Math.max(0,
        (recovery * 0.8 + moisture * 0.25) * (1 - invLocal * 0.7) + (rand() - 0.5) * 0.15
      ));

      // Plot health combines both
      const health = Math.min(1, Math.max(0, natLocal * 0.7 + (1 - invLocal) * 0.4 + (rand() - 0.5) * 0.08));

      // Decide glyph: native if native dominance, invasive if invasive dominance, else bare
      let glyph = null;
      if (invLocal > natLocal + 0.12 && invLocal > 0.25) glyph = 'invasive';
      else if (natLocal > 0.3 && natLocal > invLocal) glyph = 'native';

      if (glyph === 'native') nativeTotal++;
      if (glyph === 'invasive') invasiveTotal++;
      healthSum += health;

      plots.push({ x, y, health, invLocal, natLocal, glyph });
    }
  }

  const nativePct = Math.round((nativeTotal / TOTAL_PLOTS) * 100);
  const invasivePct = Math.round((invasiveTotal / TOTAL_PLOTS) * 100);
  const avgHealth = healthSum / TOTAL_PLOTS;

  // Trajectory label
  let trajectory, trajIcon;
  if (avgHealth < 0.3)      { trajectory = 'Degraded';   trajIcon = '⚠️'; }
  else if (avgHealth < 0.5) { trajectory = 'Stabilising'; trajIcon = '↔️'; }
  else if (avgHealth < 0.75){ trajectory = 'Recovering'; trajIcon = '↗️'; }
  else                      { trajectory = 'Thriving';   trajIcon = '🌿'; }

  // Render
  const output = document.getElementById('simulation-output');
  output.innerHTML = `
    <h3>Simulation Results <span style="font-size:0.8rem; font-weight:400; color:#777;">(${time}-year projection)</span></h3>
    <div class="landscape-wrap">
      <div class="landscape" id="landscape" aria-label="Restoration landscape heatmap"></div>
      <div class="sim-stats">
        <div class="stat">
          <div class="stat-label">Native cover</div>
          <div class="stat-value">${nativePct}%</div>
        </div>
        <div class="stat invasive-stat">
          <div class="stat-label">Invasive cover</div>
          <div class="stat-value">${invasivePct}%</div>
        </div>
        <div class="stat trajectory-stat">
          <div class="stat-label">Trajectory</div>
          <div class="stat-value">${trajIcon} ${trajectory}</div>
        </div>
      </div>
    </div>
  `;

  const landscape = document.getElementById('landscape');
  plots.forEach(p => {
    const cell = document.createElement('div');
    cell.className = 'plot' + (p.health > 0.55 ? ' healthy' : '');
    cell.style.background = soilColor(p.health, moisture);
    cell.title = `Plot (${p.x + 1},${p.y + 1}) · Native: ${Math.round(p.natLocal * 100)}% · Invasive: ${Math.round(p.invLocal * 100)}% · Health: ${Math.round(p.health * 100)}%`;
    if (p.glyph === 'native') cell.innerHTML = GLYPH_NATIVE;
    else if (p.glyph === 'invasive') cell.innerHTML = GLYPH_INVASIVE;
    landscape.appendChild(cell);
  });
}

function resetSimulation() {
  rainfallInput.value = 800;
  invasiveInput.value = 50;
  effortInput.value = 50;
  timeInput.value = 5;
  rainfallVal.textContent = '800 mm';
  invasiveVal.textContent = '50%';
  effortVal.textContent = '50%';
  timeVal.textContent = '5 years';
  document.getElementById('simulation-output').innerHTML =
    `<h3>Simulation Results</h3><p class="placeholder-text">Adjust the variables and run the simulation to see results.</p>`;
}
```

